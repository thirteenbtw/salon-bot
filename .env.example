# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID мастеров через запятую (свой ID можно узнать командой /id)
MASTER_IDS=
# Демо-режим: любой может стать мастером командой /master (чтобы можно было попробовать обе стороны).
# В боевом режиме поставьте false.
DEMO_MODE=true
TZ=Europe/Moscow
SALON_NAME=Салон «Лотос»`
SALON_ADDRESS=ул. Примерная, 1
WORK_START=10:00
WORK_END=20:00
SLOT_STEP_MIN=30
DAYS_AHEAD=14
# Выходные дни недели: 0=пн ... 6=вс (например "6" или "5,6")
DAYS_OFF=6
DB_PATH=/data/salon.db
